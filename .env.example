# App
APP_NAME=Tilas
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://timbang:timbang@localhost:5432/timbang

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 9Router / LLM
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=change-me

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Langflow
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=
LANGFLOW_MAKER_FLOW_ID=
LANGFLOW_TIMEOUT_SECONDS=120
